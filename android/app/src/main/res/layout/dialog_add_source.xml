<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:text="@string/dialog_add_source_name_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/source_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dialog_add_source_name_hint"
            android:inputType="text"
            android:maxLines="1"/>

        <TextView
            android:text="@string/dialog_add_source_repo_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/source_repo_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dialog_add_source_repo_hint"
            android:inputType="text"
            android:maxLines="1"/>

        <TextView
            android:text="@string/dialog_add_source_asset_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/source_asset_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dialog_add_source_asset_hint"
            android:inputType="text"
            android:maxLines="1"/>

        <TextView
            android:text="@string/dialog_add_source_asset_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="4dp"/>

        <CheckBox
            android:id="@+id/source_zip_checkbox"
            android:text="@string/dialog_add_source_zip_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="14dp"/>

        <LinearLayout
            android:id="@+id/source_zip_pattern_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:text="@string/dialog_add_source_zip_pattern_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="8dp"/>

            <EditText
                android:id="@+id/source_zip_pattern_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/dialog_add_source_zip_pattern_hint"
                android:text="*.bin"
                android:inputType="text"
                android:maxLines="1"/>

            <TextView
                android:text="@string/dialog_add_source_zip_pattern_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/source_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorError"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>

    </LinearLayout>

</ScrollView>
