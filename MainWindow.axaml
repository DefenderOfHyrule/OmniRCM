<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OmniRCM.MainWindow"
        Title="OmniRCM"
        Width="860"
        Height="680"
        MinWidth="720"
        MinHeight="540"
        CanResize="True"
        Background="#0F1117">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="Assets/in-app-icon-4.png"
                           Width="50"
                           Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="OmniRCM"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="VersionLabel"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="12,6" CornerRadius="50"
                        Background="{DynamicResource PillBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="PillDot"
                                 Width="8" Height="8"
                                 Fill="#607D8B"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="DeviceStatusLabel"
                                   Text="Waiting for RCM device…"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="UpdateBannerBorder"
                        Grid.Column="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="12,5" CornerRadius="14"
                        Background="#0D1F35"
                        BorderBrush="{DynamicResource AccentBlue}"
                        BorderThickness="1"
                        IsVisible="False"
                        ZIndex="2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateBannerLabel"
                                   FontSize="12" Foreground="#64B5F6"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="UpdateNowButton"
                                Content="Update now"
                                FontSize="11" FontWeight="SemiBold"
                                Padding="10,3"
                                Background="{DynamicResource AccentBlue}"
                                Foreground="White" CornerRadius="8"/>
                        <Button x:Name="UpdateDismissButton"
                                Content="✕" FontSize="10"
                                Padding="5,3"
                                Background="Transparent"
                                Foreground="#64B5F6"
                                BorderThickness="0" CornerRadius="8"/>
                    </StackPanel>
                </Border>

                <Button x:Name="SettingsButton"
                        Grid.Column="2"
                        Padding="8,6" Margin="6,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Settings">
                    <Image x:Name="SettingsIcon" Width="16" Height="16"/>
                </Button>

                <Button x:Name="ThemeToggle"
                        Grid.Column="3"
                        Padding="8,6" Margin="2,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center">
                    <Image x:Name="ThemeIcon" Width="16" Height="16"/>
                </Button>

                <Button x:Name="CreditsButton"
                        Grid.Column="4"
                        Content="?" FontSize="14" FontWeight="Bold"
                        Padding="8,6"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextMuted}"
                        ToolTip.Tip="About OmniRCM"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,14,*" Margin="14,12,14,12">

            <Grid Grid.Column="0" RowDefinitions="*,10,Auto">

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">

                    <Border Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <StackPanel Spacing="10">

                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                <TextBlock Text="Device"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="DeviceInstallDriverButton"
                                        Grid.Column="1"
                                        Content="Install Driver"
                                        FontSize="10" FontWeight="SemiBold"
                                        Padding="8,3"
                                        Background="{DynamicResource AccentRed}"
                                        Foreground="White"
                                        CornerRadius="5"
                                        IsVisible="False"/>
                            </Grid>

                            <Border x:Name="ResultPanelBorder"
                                    Background="{DynamicResource CardInner}"
                                    BorderBrush="{DynamicResource CardInnerBorder}"
                                    BorderThickness="3" CornerRadius="12" Padding="14,12">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="DeviceStateLabel"
                                                   Text="Waiting for RCM device…"
                                                   FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="DeviceSpinner"
                                                   Grid.Column="1"
                                                   Text="⠋" FontSize="18"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                    <Border x:Name="ResultDivider"
                                            IsVisible="False"
                                            Height="1"
                                            Background="{DynamicResource CardBorder}"
                                            Opacity="0.5"/>
                                    <TextBlock x:Name="ResultDetailLabel"
                                               IsVisible="False"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap"
                                               LineHeight="18"/>
                                    <TextBlock x:Name="DeviceIdLabel"
                                               Text=""
                                               FontSize="10"
                                               FontFamily="Courier New, Consolas, monospace"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ZadigHintBorder"
                                    IsVisible="False"
                                    Background="{DynamicResource CardInner}"
                                    BorderBrush="{DynamicResource AccentRed}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel Spacing="8">

                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="DriverHintTitle"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource AccentRed}"/>
                                        <TextBlock x:Name="DriverHintDescription"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,8,Auto">

                                        <Button x:Name="InstallDriverButton"
                                                FontSize="11" FontWeight="SemiBold"
                                                Padding="10,6"
                                                Background="{DynamicResource AccentRed}"
                                                Foreground="White"
                                                CornerRadius="6"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"/>

                                        <Button x:Name="ZadigButton"
                                                Grid.Column="2"
                                                FontSize="10"
                                                Padding="8,6"
                                                Background="{DynamicResource ButtonBg}"
                                                Foreground="{DynamicResource TextMuted}"
                                                CornerRadius="6"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                </StackPanel>
                            </Border>


                            <Border Background="{DynamicResource CardInner}"
                                    BorderBrush="{DynamicResource CardInnerBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Auto-inject on connect"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Runs once per connection."
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoInjectToggle"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Margin="10,0,0,0"
                                                  OnContent="" OffContent=""/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <StackPanel Spacing="10">

                            <TextBlock Text="Payload"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,0,0,2"/>

                            <Border Background="{DynamicResource CardInner}"
                                    BorderBrush="{DynamicResource CardInnerBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Fetched payloads"
                                                   FontSize="10" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="FetchButton"
                                                Grid.Column="1"
                                                Content="↓ Update"
                                                FontSize="10" Padding="8,3"
                                                Background="{DynamicResource ButtonBg}"
                                                Foreground="{DynamicResource TextPrimary}"
                                                CornerRadius="5"/>
                                    </Grid>
                                    <StackPanel x:Name="FetchedList" Spacing="2"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardInner}"
                                    BorderBrush="{DynamicResource CardInnerBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Payload sources"
                                                   FontSize="10" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="AddSourceButton"
                                                Grid.Column="1"
                                                Content="+ Add"
                                                FontSize="10" Padding="8,3"
                                                Background="{DynamicResource ButtonBg}"
                                                Foreground="{DynamicResource TextPrimary}"
                                                CornerRadius="5"/>
                                    </Grid>
                                    <StackPanel x:Name="SourcesList" Spacing="2"/>
                                    <TextBlock x:Name="NoSourcesLabel"
                                               Text="No custom sources added yet."
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardInner}"
                                    BorderBrush="{DynamicResource CardInnerBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Custom payload"
                                               FontSize="10" FontWeight="Medium"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <Grid ColumnDefinitions="*,6,Auto">
                                        <TextBox x:Name="CustomPathBox"
                                                 Watermark="Path to .bin file..."
                                                 FontSize="12" Padding="8,5" CornerRadius="6"/>
                                        <Button x:Name="BrowseButton"
                                                Grid.Column="2"
                                                Content="Browse"
                                                FontSize="11" Padding="10,5"
                                                Background="{DynamicResource ButtonBg}"
                                                Foreground="{DynamicResource TextPrimary}"
                                                CornerRadius="6"/>
                                    </Grid>
                                    <RadioButton x:Name="CustomRadio"
                                                 GroupName="PayloadGroup"
                                                 Content="Use custom payload"
                                                 FontSize="12"
                                                 Foreground="{DynamicResource TextPrimary}"/>

                                    <Border Height="1"
                                            Background="{DynamicResource CardBorder}"
                                            Opacity="0.5"
                                            Margin="0,4"/>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Favorites"
                                                   FontSize="10" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="AddFavoriteButton"
                                                Grid.Column="1"
                                                Content="☆ Save"
                                                FontSize="10" Padding="8,3"
                                                Background="{DynamicResource ButtonBg}"
                                                Foreground="{DynamicResource TextPrimary}"
                                                CornerRadius="5"/>
                                    </Grid>
                                    <StackPanel x:Name="FavoritesList" Spacing="2"/>
                                    <TextBlock x:Name="NoFavoritesLabel"
                                               Text="No favorite payloads saved yet."
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="PayloadTypeBadge"
                                    IsVisible="False"
                                    Background="{DynamicResource PillBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="10,5" HorizontalAlignment="Left">
                                <TextBlock x:Name="PayloadTypeLabel"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBlue}"/>
                            </Border>

                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnDefinitions="*,8,Auto">
                    <Button x:Name="InjectButton"
                            Content="▶  Inject Payload"
                            FontSize="14" FontWeight="SemiBold"
                            Padding="0,12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#4CAF50"
                            Foreground="White"
                            CornerRadius="8"
                            IsEnabled="False"/>
                    <Button x:Name="CancelButton"
                            Grid.Column="2"
                            Content="✕"
                            FontSize="14" Padding="14,12"
                            Background="{DynamicResource ButtonBg}"
                            Foreground="{DynamicResource TextPrimary}"
                            CornerRadius="8"
                            IsVisible="False"/>
                </Grid>

            </Grid>

            <Border Grid.Column="2"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="16,12">
                <Grid RowDefinitions="Auto,*">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="Log"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="ClearLogButton"
                                Grid.Column="1"
                                Content="Clear"
                                FontSize="10" Padding="6,2"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextMuted}"/>
                    </Grid>

                    <TextBox Grid.Row="1"
                             x:Name="LogText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             FontSize="11"
                             FontFamily="Courier New, Consolas, monospace"
                             Foreground="{DynamicResource LogFg}"
                             Background="{DynamicResource CardInner}"
                             BorderBrush="{DynamicResource CardInnerBorder}"
                             BorderThickness="1"
                             CornerRadius="6"
                             Padding="8"
                             TextWrapping="Wrap"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"/>

                </Grid>
            </Border>

        </Grid>

        <Panel Grid.Row="0" Grid.RowSpan="2"
               x:Name="UpdateOverlay"
               IsVisible="False"
               ZIndex="20">
            <Border Background="#CC000000"/>
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="36,28"
                    MinWidth="300">
                <StackPanel Spacing="18" HorizontalAlignment="Center">

                    <TextBlock x:Name="UpdateOverlaySpinner"
                               Text="⠋"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBlue}"/>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Update in progress"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="UpdateOverlayMessage"
                                   Text=""
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="260"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Panel>

        <Panel Grid.Row="0" Grid.RowSpan="2"
               x:Name="SettingsOverlay"
               IsVisible="False"
               ZIndex="18">
            <Border Background="#CC000000"/>
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="28,24"
                    MinWidth="340" MaxWidth="400">
                <StackPanel Spacing="16">

                    <TextBlock Text="Settings"
                               FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <Border Height="1" Background="{DynamicResource CardBorder}"/>

                    <Border Background="{DynamicResource CardInner}"
                            BorderBrush="{DynamicResource CardInnerBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Minimize to tray"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Closing the window keeps OmniRCM running."
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="MinimizeToTrayToggle"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,0"
                                          OnContent="" OffContent=""/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource CardInner}"
                            BorderBrush="{DynamicResource CardInnerBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Launch on boot"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Start OmniRCM automatically when you log in."
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="LaunchOnBootToggle"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,0"
                                          OnContent="" OffContent=""/>
                        </Grid>
                    </Border>

                    <Border x:Name="StartMinimizedBorder"
                            Background="{DynamicResource CardInner}"
                            BorderBrush="{DynamicResource CardInnerBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12,8"
                            Margin="16,0,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Start minimized to tray"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Opens in the background instead of showing the window."
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="StartMinimizedOnBootToggle"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,0"
                                          OnContent="" OffContent=""/>
                        </Grid>
                    </Border>

                    <Border x:Name="AppLauncherBorder"
                            IsVisible="False"
                            Background="{DynamicResource CardInner}"
                            BorderBrush="{DynamicResource CardInnerBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Add to app launcher"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Shows OmniRCM as an app in your launcher/shelf, with an icon."
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AppLauncherToggle"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,0"
                                          OnContent="" OffContent=""/>
                        </Grid>
                    </Border>

                    <Border Height="1" Background="{DynamicResource CardBorder}"/>

                    <Button x:Name="SettingsCloseButton"
                            Content="Close"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,8"
                            Background="{DynamicResource AccentGreen}"
                            Foreground="White"
                            CornerRadius="8"
                            FontWeight="SemiBold"/>

                </StackPanel>
            </Border>
        </Panel>

        <Panel Grid.Row="0" Grid.RowSpan="2"
               x:Name="CreditsOverlay"
               IsVisible="False"
               ZIndex="19">
            <Border Background="#CC000000"/>
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="36,28"
                    MinWidth="340" MaxWidth="420">
                <StackPanel Spacing="16">

                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="OmniRCM"
                                   FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="CreditsVersionLabel"
                                   Text="v1.0.0"
                                   FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentGreen}"/>
                        <TextBlock Text="Cross-platform Tegra X1 RCM payload injector"
                                   FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource CardBorder}"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Based on"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="TegraRcmSmash by rajkosto"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="JTegraNX by dylwedma11748"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="CrystalRCM by prayerie"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Quark.NET by DefenderOfHyrule"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource CardBorder}"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Built with"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="Avalonia UI  ·  .NET 10  ·  libusb-1.0  ·  libusbK (Windows)"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource CardBorder}"/>

                    <Button x:Name="CreditsUpdateButton"
                            IsVisible="False"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,8"
                            Background="{DynamicResource AccentBlue}"
                            Foreground="White"
                            CornerRadius="8"
                            FontWeight="SemiBold"/>

                    <Button x:Name="CreditsCloseButton"
                            Content="Close"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,8"
                            Background="{DynamicResource AccentGreen}"
                            Foreground="White"
                            CornerRadius="8"
                            FontWeight="SemiBold"/>

                </StackPanel>
            </Border>
        </Panel>

    </Grid>
</Window>
